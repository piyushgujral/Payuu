rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Voice recordings are stored in Cloudflare R2 now. Keep the legacy
    // Firebase Storage path closed so it cannot become an unbounded public
    // upload surface.
    match /superchat-voice/{fileName} {
      allow read, write: if false;
    }

    match /engagement-assets/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource != null
                    && request.resource.size <= 50 * 1024 * 1024
                    && (request.resource.contentType == 'image/png'
                        || request.resource.contentType == 'image/jpeg'
                        || request.resource.contentType == 'image/gif'
                        || request.resource.contentType == 'video/mp4'
                        || request.resource.contentType.matches('audio/.*'));
      allow update, delete: if request.auth != null;
    }
  }
}
